    },
    "ttl_hours": {
      "default": 24,
      "maximum": 168,
      "minimum": 1,
      "title": "Ttl Hours",
      "type": "integer"
    }
  },
  "required": [
    "scope"
  ],
  "title": "GrantCreateRequest",
  "type": "object"
}
