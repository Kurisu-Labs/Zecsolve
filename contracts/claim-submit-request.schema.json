{
  "additionalProperties": false,
  "properties": {
    "reported_txid": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Txid"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "disclosure_version": {
      "const": "claim-disclosure-v1",
      "title": "Disclosure Version",
      "type": "string"
    },
    "processing_authorized": {
      "const": true,
      "title": "Processing Authorized",
      "type": "boolean"
    },
    "share_with_reviewers": {
      "default": false,
      "title": "Share With Reviewers",
      "type": "boolean"
    }
  },
  "required": [
    "disclosure_version",
    "processing_authorized"
  ],
  "title": "ClaimSubmitRequest",
  "type": "object"
}
