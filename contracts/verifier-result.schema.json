{
  "$defs": {
    "ReceiptState": {
      "enum": [
        "NONE",
        "VALID",
        "INVALID",
        "UNSUPPORTED",
        "UNAVAILABLE",
        "ERROR"
      ],
      "title": "ReceiptState",
      "type": "string"
    },
    "RecoveredOutput": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "const": "mainnet",
          "title": "Network",
          "type": "string"
        },
        "pool": {
          "enum": [
            "orchard",
            "sapling"
          ],
          "title": "Pool",
          "type": "string"
        },
        "txid": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Txid",
          "type": "string"
        },
        "output_index": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Output Index",
          "type": "integer"
        },
        "amount_zat": {
          "maximum": 2100000000000000,
          "minimum": 0,
          "title": "Amount Zat",
          "type": "integer"
        },
        "receiver_hex": {
          "pattern": "^[0-9a-f]{86}$",
          "title": "Receiver Hex",
          "type": "string"
        },
        "receiver_address": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Receiver Address",
          "type": "string"
        },
        "memo_hex": {
          "pattern": "^[0-9a-f]{1024}$",
          "title": "Memo Hex",
          "type": "string"
        }
      },
      "required": [
        "network",
        "pool",
        "txid",
        "output_index",
        "amount_zat",
        "receiver_hex",
        "receiver_address",
        "memo_hex"
      ],
      "title": "RecoveredOutput",
      "type": "object"
    },
    "VerifierIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "zecsolve-verifier",
          "default": "zecsolve-verifier",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "glasspane_revision": {
          "const": "f6468e6d08a7adad53bf2991a311358dc84e869b",
          "default": "f6468e6d08a7adad53bf2991a311358dc84e869b",
          "title": "Glasspane Revision",
          "type": "string"
        }
      },
      "title": "VerifierIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "verifier": {
      "$ref": "#/$defs/VerifierIdentity"
    },
    "receipt_state": {
      "$ref": "#/$defs/ReceiptState"
    },
    "chain_state": {
      "const": "UNAVAILABLE",
      "default": "UNAVAILABLE",
      "title": "Chain State",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 80,
      "pattern": "^[A-Z_]+$",
      "title": "Reason Code",
      "type": "string"
    },
    "raw_tx_verified": {
      "default": false,
      "title": "Raw Tx Verified",
      "type": "boolean"
    },
    "signature_state": {
      "default": "NONE",
      "enum": [
        "NONE",
        "VALID",
        "INVALID"
      ],
      "title": "Signature State",
      "type": "string"
    },
    "receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receipt Sha256"
    },
    "raw_tx_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Tx Sha256"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecoveredOutput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "receipt_state",
    "reason_code"
  ],
  "title": "VerificationReport",
  "type": "object"
}
