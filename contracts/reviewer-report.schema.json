          "title": "Verification Id"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "allocated_zat": {
          "maximum": 2100000000000000,
