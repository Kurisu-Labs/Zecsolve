{
  "$defs": {
    "CaseState": {
      "enum": [
        "OPEN",
        "AWAITING_EVIDENCE",
        "UNDER_REVIEW",
        "RESOLVED",
        "CLOSED_UNRESOLVED"
      ],
      "title": "CaseState",
      "type": "string"
    },
    "ChainState": {
      "enum": [
        "CONFIRMED",
        "UNCONFIRMED",
        "UNAVAILABLE"
      ],
      "title": "ChainState",
      "type": "string"
    },
    "InvoicePolicyV1": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "invoice-policy-v1",
          "default": "invoice-policy-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "rules_version": {
          "default": "0.1.0",
          "title": "Rules Version",
          "type": "string"
        },
        "minimum_confirmations": {
          "default": 10,
          "exclusiveMinimum": 0,
          "title": "Minimum Confirmations",
          "type": "integer"
        },
        "max_observation_age_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Max Observation Age Seconds",
          "type": "integer"
        },
        "memo_binding": {
          "const": "exact",
          "default": "exact",
          "title": "Memo Binding",
          "type": "string"
        },
        "allow_overpayment": {
          "const": false,
          "default": false,
          "title": "Allow Overpayment",
          "type": "boolean"
        },
        "unique_receiver_binding": {
          "const": false,
          "default": false,
          "title": "Unique Receiver Binding",
          "type": "boolean"
        }
      },
      "title": "InvoicePolicyV1",
      "type": "object"
    },
    "InvoiceTermsV1": {
      "additionalProperties": false,
      "properties": {
        "expected_zat": {
          "exclusiveMinimum": 0,
          "maximum": 2100000000000000,
          "title": "Expected Zat",
          "type": "integer"
        },
        "network": {
          "const": "mainnet",
          "title": "Network",
          "type": "string"
        },
        "pool": {
          "enum": [
            "orchard",
            "sapling"
          ],
          "title": "Pool",
          "type": "string"
        },
        "receiver_address": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Receiver Address",
          "type": "string"
        },
        "expected_memo": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Memo"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "receiver_hex": {
          "pattern": "^[0-9a-f]{86}$",
          "title": "Receiver Hex",
          "type": "string"
        },
        "memo_hex": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{1024}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memo Hex"
        }
      },
      "required": [
        "expected_zat",
        "network",
        "pool",
        "receiver_address",
        "receiver_hex",
        "memo_hex"
      ],
      "title": "InvoiceTermsV1",
      "type": "object"
    },
    "OfflineEvaluationV1": {
      "additionalProperties": false,
      "properties": {
        "rules_version": {
          "title": "Rules Version",
          "type": "string"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "credited_zat": {
          "minimum": 0,
          "title": "Credited Zat",
          "type": "integer"
        },
        "outstanding_zat": {
          "minimum": 0,
          "title": "Outstanding Zat",
          "type": "integer"
        },
        "excess_zat": {
          "minimum": 0,
          "title": "Excess Zat",
          "type": "integer"
        },
        "candidate_zat": {
          "maximum": 2100000000000000,
          "minimum": 0,
          "title": "Candidate Zat",
          "type": "integer"
        },
        "projected_outstanding_zat": {
          "minimum": 0,
          "title": "Projected Outstanding Zat",
          "type": "integer"
        },
        "eligible_for_credit": {
          "const": false,
          "default": false,
          "title": "Eligible For Credit",
          "type": "boolean"
        }
      },
      "required": [
        "rules_version",
        "findings",
        "credited_zat",
        "outstanding_zat",
        "excess_zat",
        "candidate_zat",
        "projected_outstanding_zat"
      ],
      "title": "OfflineEvaluationV1",
      "type": "object"
    },
    "ReceiptState": {
      "enum": [
        "NONE",
        "VALID",
        "INVALID",
        "UNSUPPORTED",
        "UNAVAILABLE",
        "ERROR"
      ],
      "title": "ReceiptState",
      "type": "string"
    },
    "RecoveredOutput": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "const": "mainnet",
          "title": "Network",
          "type": "string"
        },
        "pool": {
          "enum": [
            "orchard",
            "sapling"
          ],
          "title": "Pool",
          "type": "string"
        },
        "txid": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Txid",
          "type": "string"
        },
        "output_index": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Output Index",
          "type": "integer"
        },
        "amount_zat": {
          "maximum": 2100000000000000,
          "minimum": 0,
          "title": "Amount Zat",
          "type": "integer"
        },
        "receiver_hex": {
          "pattern": "^[0-9a-f]{86}$",
          "title": "Receiver Hex",
          "type": "string"
        },
        "receiver_address": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Receiver Address",
          "type": "string"
        },
        "memo_hex": {
          "pattern": "^[0-9a-f]{1024}$",
          "title": "Memo Hex",
          "type": "string"
        }
      },
      "required": [
        "network",
        "pool",
        "txid",
        "output_index",
        "amount_zat",
        "receiver_hex",
        "receiver_address",
        "memo_hex"
      ],
      "title": "RecoveredOutput",
      "type": "object"
    },
    "ReviewerCaseV1": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/CaseState"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "state",
        "version",
        "created_at"
      ],
      "title": "ReviewerCaseV1",
      "type": "object"
    },
    "ReviewerClaimV1": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "reported_txid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Txid"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "assertion": {
          "const": true,
          "default": true,
          "title": "Assertion",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "reported_txid",
        "note",
        "created_at"
      ],
      "title": "ReviewerClaimV1",
      "type": "object"
