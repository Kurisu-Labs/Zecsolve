    "ReviewerDecisionV1": {
      "additionalProperties": false,
      "properties": {
        "resolution_id": {
          "format": "uuid",
          "title": "Resolution Id",
          "type": "string"
        },
        "verification_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
