{
  "$defs": {
    "CaseState": {
      "enum": [
        "OPEN",
        "AWAITING_EVIDENCE",
        "UNDER_REVIEW",
        "RESOLVED",
        "CLOSED_UNRESOLVED"
      ],
      "title": "CaseState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "merchant_id": {
      "format": "uuid",
      "title": "Merchant Id",
      "type": "string"
    },
    "submitted_by": {
      "format": "uuid",
      "title": "Submitted By",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "public_fixture",
        "merchant_submission"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "disclosure_version": {
      "const": "evidence-disclosure-v1",
      "title": "Disclosure Version",
      "type": "string"
    },
    "processing_authorized": {
      "const": true,
      "title": "Processing Authorized",
      "type": "boolean"
    },
    "share_with_reviewers": {
      "const": false,
      "title": "Share With Reviewers",
      "type": "boolean"
    },
    "receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Receipt Sha256"
    },
    "raw_tx_hex_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Tx Hex Sha256"
    },
    "payload_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "case_version": {
      "minimum": 2,
      "title": "Case Version",
      "type": "integer"
    },
    "case_state": {
      "$ref": "#/$defs/CaseState"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "case_id",
    "merchant_id",
    "submitted_by",
    "submitted_at",
    "source",
    "source_kind",
    "disclosure_version",
    "processing_authorized",
    "share_with_reviewers",
    "receipt_sha256",
    "raw_tx_hex_sha256",
    "payload_sha256",
    "case_version",
    "case_state",
    "event_id"
  ],
  "title": "EvidenceStoredV1",
  "type": "object"
}
