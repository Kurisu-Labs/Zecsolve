# Development only. Generate a random token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ZECSOLVE_POC_TOKEN=
ZECSOLVE_DATABASE_URL=postgresql+psycopg://zecsolve:zecsolve@127.0.0.1:54329/zecsolve
ZECSOLVE_VERIFIER_PATH=target/debug/zecsolve-verifier
ZECSOLVE_VERIFIER_TIMEOUT_SECONDS=10
ZECSOLVE_MIGRATIONS_PATH=apps/api/migrations
# Base64 of 32 random bytes, stored privately. Use a distinct ID for each key.
ZECSOLVE_EVIDENCE_KEY_ID=local-v1
ZECSOLVE_EVIDENCE_KEY=

# Optional trusted read-only Zebra RPC. Empty URL keeps approvals offline.
ZECSOLVE_RPC_URL=
ZECSOLVE_RPC_SOURCE_ID=trusted-zebra
ZECSOLVE_RPC_USERNAME=
ZECSOLVE_RPC_PASSWORD=
# HTTP requires explicit permission AND a private/loopback IP literal.
ZECSOLVE_RPC_ALLOW_PRIVATE_HTTP=false
ZECSOLVE_RPC_TIMEOUT_SECONDS=10
ZECSOLVE_RPC_TIP_MAX_AGE_SECONDS=900

# Exact HTTPS browser origins; empty disables new browser session exchanges.
ZECSOLVE_BROWSER_ORIGINS=[]
