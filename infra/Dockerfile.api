FROM rust:1.99-bookworm AS verifier
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
RUN cargo build --locked --release -p zecsolve-verifier

FROM ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM python:3.14-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY apps/api ./apps/api
RUN uv sync --locked --no-dev --no-editable
COPY alembic.ini ./
COPY --from=verifier /build/target/release/zecsolve-verifier /usr/local/bin/zecsolve-verifier
COPY third_party ./third_party
RUN useradd --uid 10001 --create-home zecsolve
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER zecsolve
EXPOSE 8000
CMD ["uvicorn", "zecsolve.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
