server {
    listen 8080;
    server_name ${ZECSOLVE_DEPLOY_HOST};
    return 308 https://${ZECSOLVE_DEPLOY_HOST}:${ZECSOLVE_DEPLOY_HTTPS_PORT}$request_uri;
}
server {
    listen 8443 ssl;
    server_name ${ZECSOLVE_DEPLOY_HOST};
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header Cache-Control;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Server;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_read_timeout 60s;
    proxy_send_timeout 30s;

    location /api/ {
        limit_req zone=api_rate burst=10 nodelay;
        limit_conn client_connections 10;
        proxy_pass http://api:8000;
    }
    location / {
        proxy_pass http://api:8000;
    }
}
